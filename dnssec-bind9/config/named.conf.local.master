// Master (DNSMaster) — authoritative, DNSSEC-signed, TSIG-restricted transfers.
// The TSIG key is shared with the slave; only holders of it may pull the zones.

include "/etc/bind/tsig.key";          // key "transfer-key" { ... }

zone "ssi.edu" {
    type master;
    file "/etc/bind/db.ssi.edu.signed"; // the SIGNED zone, not the raw one
    allow-transfer { key "transfer-key"; };
    also-notify   { 10.71.105.191; };   // notify the slave on change
};

zone "136.105.71.in-addr.arpa" {
    type master;
    file "/etc/bind/db.reverse.signed";
    allow-transfer { key "transfer-key"; };
    also-notify   { 10.71.105.191; };
};

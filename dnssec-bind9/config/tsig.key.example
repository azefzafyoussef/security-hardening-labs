// Generate the real key with:
//   tsig-keygen -a hmac-sha256 transfer-key > /etc/bind/tsig.key
// then copy /etc/bind/tsig.key to the slave over SSH (scp).
// This is a PLACEHOLDER secret — do not reuse it.
key "transfer-key" {
    algorithm hmac-sha256;
    secret "REPLACE_ME_WITH_tsig-keygen_OUTPUT=";
};
